# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/mobile/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

.env*.local

# Local preserved builds and guarded safety copies
/.next.group*-before/
/.next.group*-failed/
*-before

# Keep the safe environment-variable template in version control
!.env.example

# Local diagnostics and runtime artifacts
/.tmp*
/tmp/
/.runtime/
/*.log
*.backup
